    {"source": {"module_id": "filter_motion", "port_id": "output"}, "target": {"module_id": "acid_filter", "port_id": "cutoff_cv"}},
    {"source": {"module_id": "acid_filter", "port_id": "low_18"}, "target": {"module_id": "bass_vca", "port_id": "signal"}},
    {"source": {"module_id": "bass_env", "port_id": "envelope"}, "target": {"module_id": "bass_vca", "port_id": "level_cv"}},
