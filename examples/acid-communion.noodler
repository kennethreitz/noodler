    {"source": {"module_id": "stab_4", "port_id": "audio"}, "target": {"module_id": "stab_mix", "port_id": "input_4"}},
    {"source": {"module_id": "stab_mix", "port_id": "output"}, "target": {"module_id": "stab_glue", "port_id": "audio"}},
    {"source": {"module_id": "hook", "port_id": "pitch"}, "target": {"module_id": "hook_voice", "port_id": "pitch"}},
    {"source": {"module_id": "hook", "port_id": "gate"}, "target": {"module_id": "hook_voice", "port_id": "gate"}},
