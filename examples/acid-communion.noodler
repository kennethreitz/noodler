    {"source": {"module_id": "hook_voice", "port_id": "audio"}, "target": {"module_id": "master", "port_id": "channel_4"}},
    {"source": {"module_id": "master", "port_id": "send_a"}, "target": {"module_id": "warehouse", "port_id": "audio"}},
    {"source": {"module_id": "master", "port_id": "send_b"}, "target": {"module_id": "dub_echo", "port_id": "audio"}},
    {"source": {"module_id": "warehouse", "port_id": "wet_left"}, "target": {"module_id": "master", "port_id": "return_a_left"}},
    {"source": {"module_id": "warehouse", "port_id": "wet_right"}, "target": {"module_id": "master", "port_id": "return_a_right"}},
    {"source": {"module_id": "dub_echo", "port_id": "wet"}, "target": {"module_id": "master", "port_id": "return_b_left"}},
    {"source": {"module_id": "dub_echo", "port_id": "wet"}, "target": {"module_id": "master", "port_id": "return_b_right"}}
