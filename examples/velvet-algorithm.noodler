{
  "format": "noodler.patch",
  "format_version": 1,
  "application_version": "0.1.0",
  "name": "Velvet Algorithm",
  "modules": [
    {
      "instance_id": "clock",
      "module_type": "clock",
      "provider": "builtin",
      "parameters": {
        "rate_hz": 1.2,
        "beats_per_bar": 4,
        "trigger_ms": 6.0
      }
    },
    {
      "instance_id": "drums",
      "module_type": "pytheory_beats",
      "provider": "builtin",
      "parameters": {
        "pattern": "jazz",
        "level": 0.38,
        "swing": 0.0,
        "follow_clock": true,
        "rate_hz": 1.2
      }
    },
    {
      "instance_id": "progression",
      "module_type": "pytheory_progression",
      "provider": "builtin",
      "parameters": {
        "progression": "Dorian vamp",
        "custom": "i IV ii v",
        "tonic": "D",
        "mode": "dorian",
        "voicing": "drop2",
        "octave": 3,
        "style": "wander",
        "bars_per_chord": 1,
        "follow_clock": true,
        "rate_hz": 0.3,
        "gate_length": 0.82,
        "reference_frequency_hz": 220.0,
        "seed": 2718
      }
    },
    {
      "instance_id": "ear",
      "module_type": "pytheory_chord_ear",
      "provider": "builtin",
      "parameters": {
        "reference_frequency_hz": 220.0,
        "hold": true
      }
    },
    {
      "instance_id": "melody",
      "module_type": "melody_brain",
      "provider": "builtin",
      "parameters": {
        "system": "western",
        "tonic": "D",
        "octave": 4,
        "scale_name": "dorian",
        "style": "motif and answer",
        "phrase_length": 16,
        "octave_range": 2,
        "density": 0.58,
        "step_bias": 0.83,
        "rate_hz": 2.4,
        "gate_length": 0.48,
        "reference_frequency_hz": 220.0,
        "seed": 1618
      }
    },
    {
      "instance_id": "shadow",
      "module_type": "pytheory_negative_harmony",
      "provider": "builtin",
      "parameters": {
        "tonic": "D",
        "mode": "minor",
        "mirror": true,
        "reference_frequency_hz": 220.0
      }
    },
    {
      "instance_id": "chance",
      "module_type": "wogglebug",
      "provider": "builtin",
      "parameters": {
        "clock_rate_hz": 0.3,
        "chaos": 0.32,
        "ego_id_balance": 0.58,
        "woggle": 0.42,
        "audio_level": 0.0,
        "seed": 8088
      }
    },
    {
      "instance_id": "breath",
      "module_type": "lfo",
      "provider": "builtin",
      "parameters": {
        "rate_hz": 0.03125,
        "shape": "smooth random",
        "depth": 0.72,
        "offset": 0.08,
        "phase": 0.0,
        "pulse_width": 0.5,
        "unipolar": true,
        "seed": 404
      }
    },
    {
      "instance_id": "bass",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "upright_bass",
        "level": 0.34,
        "release_ms": 620.0,
        "reference_frequency_hz": 220.0
      }
    },
    {
      "instance_id": "keys_low",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "electric_piano",
        "level": 0.16,
        "release_ms": 960.0,
        "reference_frequency_hz": 220.0
      }
    },
    {
      "instance_id": "keys_mid",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "wurlitzer",
        "level": 0.14,
        "release_ms": 900.0,
        "reference_frequency_hz": 220.0
      }
    },
    {
      "instance_id": "keys_high",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "electric_piano",
        "level": 0.13,
        "release_ms": 1080.0,
        "reference_frequency_hz": 220.0
      }
    },
    {
      "instance_id": "sax",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "tenor_sax",
        "level": 0.21,
        "release_ms": 460.0,
        "reference_frequency_hz": 220.0
      }
    },
    {
      "instance_id": "vibes",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "vibraphone",
        "level": 0.16,
        "release_ms": 1180.0,
        "reference_frequency_hz": 440.0
      }
    },
    {
      "instance_id": "pad",
      "module_type": "supersaw",
      "provider": "builtin",
      "parameters": {
        "frequency": 220.0,
        "voices": 7,
        "detune_cents": 12.0,
        "curve": 0.48,
        "amplitude": 0.09
      }
    },
    {
      "instance_id": "smoke",
      "module_type": "ladder_filter",
      "provider": "builtin",
      "parameters": {
        "cutoff_hz": 640.0,
        "resonance": 0.18,
        "drive": 1.28,
        "output_level": 0.7
      }
    },
    {
      "instance_id": "moon_phaser",
      "module_type": "pytheory_fx",
      "provider": "builtin",
      "parameters": {
        "effect": "phaser",
        "mix": 0.48,
        "rate_hz": 0.11,
        "depth": 0.38,
        "drive": 1.0,
        "brightness": 0.5
      }
    },
    {
      "instance_id": "plate",
      "module_type": "pytheory_reverb",
      "provider": "builtin",
      "parameters": {
        "space": "plate",
        "mix": 1.0,
        "decay_seconds": 3.2,
        "width": 0.88,
        "pre_delay_ms": 14.0,
        "level": 0.84
      }
    },
    {
      "instance_id": "tape_echo",
      "module_type": "echo_delay",
      "provider": "builtin",
      "parameters": {
        "time_seconds": 0.625,
        "feedback": 0.3,
        "mix": 1.0,
        "damping": 0.62,
        "drive": 0.94,
        "freeze": false
      }
    },
    {
      "instance_id": "master",
      "module_type": "master_mixer",
      "provider": "builtin",
      "parameters": {
        "levels": [0.54, 0.78, 0.62, 0.56, 0.5, 0.7, 0.54, 0.44],
        "pans": [0.0, -0.05, -0.48, 0.04, 0.47, 0.3, -0.56, 0.15],
        "sends_a": [0.12, 0.1, 0.36, 0.42, 0.47, 0.42, 0.62, 0.72],
        "sends_b": [0.02, 0.0, 0.12, 0.16, 0.2, 0.28, 0.48, 0.18],
        "mutes": [false, false, false, false, false, false, false, false],
        "solos": [false, false, false, false, false, false, false, false],
        "return_levels": [0.44, 0.25],
        "return_mutes": [false, false],
        "master": 0.76
      }
    }
  ],
  "cables": [
