{
  "format": "noodler.patch",
  "format_version": 1,
  "application_version": "0.1.0",
  "name": "Lantern Procession",
  "modules": [
    {
      "instance_id": "clock",
      "module_type": "clock",
      "provider": "builtin",
      "parameters": {
        "rate_hz": 1.6333333333333333,
        "beats_per_bar": 4,
        "trigger_ms": 6
      }
    },
    {
      "instance_id": "drums",
      "module_type": "pytheory_beats",
      "provider": "builtin",
      "parameters": {
        "pattern": "second line",
        "level": 0.46,
        "swing": 0,
        "follow_clock": true,
        "rate_hz": 1.6333333333333333
      }
    },
    {
      "instance_id": "chords",
      "module_type": "pytheory_score",
      "provider": "builtin",
      "parameters": {
        "phrase": "[D3,A3,D4,F4]:h [Bb2,F3,Bb3,D4]:h [G2,D3,G3,Bb3]:h [A2,E3,A3,C#4]:h",
        "gate_length": 0.68,
        "octave_shift": 0,
        "follow_clock": true,
        "rate_hz": 1.6333333333333333,
        "reference_frequency_hz": 220
      }
    },
    {
      "instance_id": "melody",
      "module_type": "pytheory_score",
      "provider": "builtin",
      "parameters": {
        "phrase": "D5:e F5:e A5:q C6:e A5:e F5:q E5:e G5:e Bb5:q A5:e E5:e C#5:q",
        "gate_length": 0.58,
        "octave_shift": 0,
        "follow_clock": true,
        "rate_hz": 1.6333333333333333,
        "reference_frequency_hz": 220
      }
    },
    {
      "instance_id": "bass",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "upright_bass",
        "level": 0.38,
        "release_ms": 820,
        "reference_frequency_hz": 220
      }
    },
    {
      "instance_id": "cello",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "cello",
        "level": 0.24,
        "release_ms": 1100,
        "reference_frequency_hz": 220
      }
    },
    {
      "instance_id": "clarinet",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "clarinet",
        "level": 0.2,
        "release_ms": 760,
        "reference_frequency_hz": 220
      }
    },
    {
      "instance_id": "horn",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "french_horn",
        "level": 0.19,
        "release_ms": 980,
        "reference_frequency_hz": 220
      }
    },
    {
      "instance_id": "trumpet",
      "module_type": "pytheory_voice",
      "provider": "builtin",
      "parameters": {
        "instrument": "trumpet",
        "level": 0.25,
        "release_ms": 460,
        "reference_frequency_hz": 220
      }
    },
    {
      "instance_id": "space",
      "module_type": "pytheory_reverb",
      "provider": "builtin",
      "parameters": {
        "space": "cathedral",
        "mix": 1,
        "decay_seconds": 3.8,
        "width": 0.9,
        "pre_delay_ms": 16,
        "level": 0.82
      }
    },
    {
      "instance_id": "echo",
      "module_type": "echo_delay",
      "provider": "builtin",
      "parameters": {
        "time_seconds": 0.4592,
        "feedback": 0.3,
        "mix": 1,
        "damping": 0.46,
        "drive": 0.9,
        "freeze": false
      }
    },
    {
      "instance_id": "master",
      "module_type": "master_mixer",
      "provider": "builtin",
      "parameters": {
        "levels": [
          0.62,
          0.75,
          0.48,
          0.44,
          0.42,
          0.6,
          0.8,
          0.8
        ],
        "pans": [
          0,
